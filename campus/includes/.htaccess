# Bloqueo total de acceso directo HTTP a archivos de configuración y datos internos
# Permite que los scripts PHP de la aplicación hagan require/include localmente,
# pero deniega cualquier petición web directa desde el navegador.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Deny from all
</IfModule>
